# =====================================================================
# MedyaTarih Backend Environment Configuration
# =====================================================================

# Optional Deep Learning Backend:
# Set to 1 to activate HuggingFace BERTurk transformer models for sentiment and embeddings.
# Requires: pip install torch transformers
# When 0 (default), uses fast rule-based lexicon and TF-IDF fallback.
MEDYATARIH_USE_BERT=0

# HuggingFace Pretrained Model IDs (if MEDYATARIH_USE_BERT=1)
MEDYATARIH_SENTIMENT_MODEL=savasy/bert-base-turkish-sentiment-cased
MEDYATARIH_EMBEDDING_MODEL=dbmdz/bert-base-turkish-cased

# CORS Allowed Origins (comma-separated list)
# Default allows local dev ports. For production, specify your domains.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
